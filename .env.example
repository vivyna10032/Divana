# 复制成 .env 后填写。.env 已被 .gitignore 排除，不会被提交。

# 你的 API key（必填）
DIVANA_API_KEY=sk-...

# 接口地址：默认 DeepSeek 官方。以后换别的 OpenAI 兼容网关就改这里
DIVANA_BASE_URL=https://api.deepseek.com

# 模型名：当前该接口可选 deepseek-v4-pro / deepseek-flash
DIVANA_MODEL=deepseek-v4-pro

# ---- 计价（给评测台账用，可选）----
# 单位是"元 / 百万 token"。评测跑完会把 token 折成钱，记进 evals/history.jsonl，
# 让你能回答"这个项目多准、多贵"。不填就用内置默认值（报告里会标"价格来源：默认值"）。
# **去官网核对一遍再填**——价目表会变，一个过期的单价会让整份台账不可信。
#
# 缓存命中的输入便宜得多（通常只有未命中的十分之一）。人格 prompt 和工具定义
# 每次调用都要重发，但那部分基本都命中缓存，所以这一项对总价影响很大。
DIVANA_PRICE_IN=4
DIVANA_PRICE_OUT=12
DIVANA_PRICE_CACHED=0.5

# ---- 联网搜索（可选）----
# 不填也能正常用，只是她遇到不确定的事只能说不确定，查不了。
# 服务商三选一：tavily / brave / serper
DIVANA_SEARCH_PROVIDER=tavily

# 对应服务商的 key。Tavily 在 https://tavily.com 注册就有免费额度
DIVANA_SEARCH_API_KEY=

# 每次搜索取几条结果
DIVANA_SEARCH_MAX_RESULTS=5

# ---- GitHub API（可选，但走代理的话强烈建议配）----
# 不填也能读公开仓库，但匿名配额只有 60 次/小时，**而且是按你的出口 IP 算的**。
# 走代理（机场节点是共享 IP）时，这 60 次经常被别人用掉 → 403 限流。
# 填了之后配额是 5000 次/小时，且按 token 算，不看 IP。
#
# 生成：GitHub → Settings → Developer settings → Personal access tokens
#       → Fine-grained tokens。不需要勾任何权限，公开仓库匿名就能读。
# 只需要一个 "Public Repositories (read-only)" 就够。
DIVANA_GITHUB_TOKEN=
